# Site identity — used across metadata, footer, hero, and legal pages so no
# personal name/handle is ever hardcoded in source. Safe to expose to the
# browser (NEXT_PUBLIC_*): this is public-facing portfolio content, not a
# secret.
NEXT_PUBLIC_OWNER_NAME="Your Name"

# Public contact details rendered on the site (Footer, About, Contact page).
# Leave unset to hide that contact method entirely rather than showing a
# broken/placeholder link.
NEXT_PUBLIC_CONTACT_EMAIL=
# E.164-style phone number, e.g. +15551234567. Used to build tel: and
# wa.me (WhatsApp) links.
NEXT_PUBLIC_CONTACT_PHONE=

# Optional social links — omit any you don't use.
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Used only by `npm run resume:generate` (see scripts/generate-resume.mjs)
# to fill resume.template.md's header block when producing the local,
# gitignored resume.md that public/cv.pdf is generated from via pandoc.
# GitLab is resume-only; the site itself doesn't link a GitLab profile.
NEXT_PUBLIC_OWNER_ROLE="Software Engineer"
NEXT_PUBLIC_OWNER_LOCATION=
NEXT_PUBLIC_GITLAB_URL=

# Contact form email delivery (Resend)
# Get key from: https://resend.com/api-keys
RESEND_API_KEY=

# Free tier: use onboarding@resend.dev
# Production: use a verified domain sender, e.g. noreply@yourdomain.com
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Server-only recipient inbox for contact form submissions. Deliberately NOT
# prefixed with NEXT_PUBLIC_ — never rendered client-side, never falls back
# to a hardcoded address in source.
CONTACT_TO_EMAIL=

# Your deployed URL — used for sitemap and Open Graph tags
NEXT_PUBLIC_SITE_URL=https://your-portfolio.vercel.app

# Optional client-side error tracking (app/error.tsx). Leave unset to skip
# Sentry entirely — captureClientError() still logs to the console either
# way. See lib/monitoring/errorTracking.ts for scope/limitations.
NEXT_PUBLIC_SENTRY_DSN=

# Hugging Face usernames — used to build live API demo URLs
# HF_USER: primary account (up to 3 concurrent free Spaces)
# HF_USER2: overflow account for additional Spaces beyond the 3-space quota
NEXT_PUBLIC_HF_USER=
NEXT_PUBLIC_HF_USER2=
