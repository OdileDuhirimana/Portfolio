# Contact form email delivery (Resend)
# Get key from: https://resend.com/api-keys
RESEND_API_KEY=

# Free tier: use onboarding@resend.dev
# Production: use a verified domain sender, e.g. noreply@yourdomain.com
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Where contact form submissions are delivered
CONTACT_TO_EMAIL=

# Your deployed URL — used for sitemap and Open Graph tags
NEXT_PUBLIC_SITE_URL=https://your-portfolio.vercel.app

# Hugging Face usernames — used to build live API demo URLs
NEXT_PUBLIC_HF_USER=
NEXT_PUBLIC_HF_USER2=
